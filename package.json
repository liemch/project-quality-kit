{
  "name": "project-quality-kit",
  "version": "0.1.4",
  "private": true,
  "description": "Sibling quality kit: Playwright e2e harness, QC Excel bridge, future AI-review CI modules",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:smoke": "playwright test e2e/specs/smoke --project=mock",
    "test:e2e-real": "cross-env PLAYWRIGHT_MODE=real playwright test",
    "qc:import": "node scripts/e2e/qc-import.mjs",
    "qc:import:py": "python3 scripts/e2e/qc-import.py",
    "qc:codegen": "node scripts/e2e/qc-codegen.mjs",
    "qc:list": "node scripts/e2e/qc-list.mjs",
    "qc:coverage": "node scripts/e2e/qc-coverage.mjs",
    "qc:run": "node scripts/e2e/qc-run.mjs",
    "qc:export": "node scripts/e2e/qc-export.mjs",
    "verify:base": "bash scripts/verify-base-template.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "cross-env": "^7.0.3",
    "js-yaml": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20"
  }
}
